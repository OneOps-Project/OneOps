model WorkforcePresence {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @db.VarChar(64)
  employeeName String   @db.VarChar(200)
  workDate     String   @db.VarChar(10)
  status       String   @default("IN_OFFICE") @db.VarChar(20)
  shiftLabel   String   @default("") @db.VarChar(120)
  note         String   @default("") @db.VarChar(500)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@map("workforce_presence")
  @@schema("hr_workforce")
}
