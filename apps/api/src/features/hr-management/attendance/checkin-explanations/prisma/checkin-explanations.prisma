model CheckinExplanation {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @db.VarChar(64)
  employeeName       String    @db.VarChar(200)
  workDate           String    @db.VarChar(10)
  type               String    @default("FORGOT_CHECKIN") @db.VarChar(30)
  reason             String    @db.VarChar(1000)
  requestedCheckIn   String    @default("") @db.VarChar(5)
  requestedCheckOut  String    @default("") @db.VarChar(5)
  status             String    @default("PENDING") @db.VarChar(20)
  decidedBy          String    @default("") @db.VarChar(200)
  decidedAt          DateTime?
  decisionNote       String    @default("") @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([employeeId, workDate, type])
  @@index([status, workDate])
  @@map("checkin_explanations")
  @@schema("hr_checkin_explanations")
}
