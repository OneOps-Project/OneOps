model WorkTask {
  id String @id @default(uuid()) @db.Uuid
  code String @db.VarChar(100)
  codeKey String @unique @db.VarChar(100)
  name String @db.VarChar(500)
  scope String @default("") @db.VarChar(250)
  status String @db.VarChar(150)
  date DateTime @db.Date
  assignee String @default("") @db.VarChar(150)
  reviewer String @default("") @db.VarChar(150)
  deadline DateTime?
  note String @default("") @db.VarChar(2000)
  attachmentLinks String[] @default([])
  statusHistory Json @default("[]")
  reassignmentFlag Json @default("{}")
  reassignmentHistory Json @default("[]")
  fields Json @default("{}")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([scope,status,date])
  @@index([assignee,status,deadline])
  @@index([reviewer,status,deadline])
  @@map("records")
  @@schema("work_tasks")
}
